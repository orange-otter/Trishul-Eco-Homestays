{
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,package-lock.json,tsconfig*.json,eslint.config.js,vite.config.ts,*.md,*.json,test_*.py,**/test_*.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
